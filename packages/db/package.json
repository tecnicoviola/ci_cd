{
  "name": "@repo/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "contract:emit": "prisma contract emit",
    "db:verify": "prisma db verify",
    "db:migrate": "prisma db migrate --advance-ref db"
  },
  "dependencies": {
    "@prisma/orm-postgres": "8.0.0-rc.22",
    "dotenv": "^18.0.9"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "26.4.1",
    "prisma": "8.0.0-rc.30",
    "typescript": "7.0.2"
  }
}
